---
import I18nKey from "@/i18n/i18nKey";
import { createTranslator } from "@/i18n/translation";
import { getLocaleFromPath } from "@/utils/locale";
const i18n = createTranslator(getLocaleFromPath(Astro.url.pathname));
const codeLabels = {
	expand: i18n(I18nKey.codeCollapsibleShowMore),
	collapse: i18n(I18nKey.codeCollapsibleShowLess),
	expanded: i18n(I18nKey.codeCollapsibleExpanded),
	collapsed: i18n(I18nKey.codeCollapsibleCollapsed),
};
---
<script is:inline define:vars={{ codeLabels }}>
  function updateCodeLabels() {
    document.querySelectorAll(".ec-collapse__text-expand").forEach((element) => {
      element.textContent = codeLabels.expand;
    });
    document.querySelectorAll(".ec-collapse__text-collapse").forEach((element) => {
      element.textContent = codeLabels.collapse;
    });
    document.querySelectorAll("[data-expanded-announcement]").forEach((element) => {
      element.dataset.expandedAnnouncement = codeLabels.expanded;
      element.dataset.collapsedAnnouncement = codeLabels.collapsed;
    });
  }
  updateCodeLabels();
  document.addEventListener("DOMContentLoaded", updateCodeLabels, { once: true });
  document.addEventListener("firefly:page:loaded", updateCodeLabels);
</script>
