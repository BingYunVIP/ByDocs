---
import { getLocaleFromPath } from "@/utils/locale";
const pageLocale = getLocaleFromPath(Astro.url.pathname);
const i18n = createTranslator(pageLocale);
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { createTranslator } from "@/i18n/translation";

interface Props {
	src: string;
}

const { src } = Astro.props;
---

<dynamic-inline-comments class="page-inline-comments" data-src={src}>
	<button type="button" class="page-comment-toggle btn-plain" data-comment-toggle>
		<Icon name="material-symbols:chat-bubble-outline-rounded" />
		<span>{i18n(I18nKey.comments)}</span>
		<Icon
			name="material-symbols:expand-more-rounded"
			class="page-comment-chevron"
		/>
	</button>
	<div class="page-comment-panel" data-comment-panel hidden></div>
</dynamic-inline-comments>
