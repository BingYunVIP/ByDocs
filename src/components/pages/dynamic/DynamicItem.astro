---
import { getLocaleFromPath, localizeConfigText } from "@/utils/locale";
const pageLocale = getLocaleFromPath(Astro.url.pathname);
const i18n = createTranslator(pageLocale);
import { type CollectionEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import DynamicGallery from "@/components/pages/dynamic/DynamicGallery.astro";
import DynamicInlineComments from "@/components/pages/dynamic/DynamicInlineComments.astro";
import { dynamicConfig, profileConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { createTranslator } from "@/i18n/translation";
import { formatDynamicDate, formatTimezoneOffset } from "@/utils/date-utils";
import { dynamicAnchor } from "@/utils/dynamic-utils";
import { url as baseUrl } from "@/utils/url-utils";

interface Props {
	entry: CollectionEntry<"dynamic">;
	detailUrl?: string;
	showInlineComments?: boolean;
	commentPath?: string;
}

const {
	entry,
	detailUrl,
	showInlineComments = false,
	commentPath,
} = Astro.props;
const translationMissing = Boolean(entry.data.translationMissing);
const Content = translationMissing ? undefined : (await render(entry)).Content;
const anchorId = dynamicAnchor(entry.id);
const published = formatDynamicDate(entry.data.published, pageLocale);
const timezone = formatTimezoneOffset(
	siteConfig.timezone || "UTC",
	entry.data.published,
);
const permalink = detailUrl || `#${anchorId}`;
const location = entry.data.location.trim();
const profileLabel = i18n(I18nKey.dynamicProfile).replace(
	"{name}",
	localizeConfigText(profileConfig.name, pageLocale),
);
const profileUrl = url(dynamicConfig.profileUrl || "/about/");

function url(path: string): string { return baseUrl(path, pageLocale); }
---

<dynamic-entry
	id={anchorId}
	class="page-entry card-base"
	data-dynamic-entry
	data-year={entry.data.published.getUTCFullYear()}
>
	<article aria-labelledby={`${anchorId}-author`}>
		<header class="page-entry-header">
			<a
				href={profileUrl}
				class="page-avatar"
				aria-label={profileLabel}
			>
				<ImageWrapper
					src={profileConfig.avatar || ""}
					alt={localizeConfigText(profileConfig.name, pageLocale)}
					widths={[96]}
					sizes="48px"
					loading="lazy"
				/>
			</a>
			<div class="page-identity">
				<a href={profileUrl} class="page-author" aria-label={profileLabel}>
					<strong id={`${anchorId}-author`}>{localizeConfigText(profileConfig.name, pageLocale)}</strong>
				</a>
				<div class="page-meta">
					<a class="page-time" href={permalink}>
						<time datetime={entry.data.published.toISOString()}>
							{published} {timezone}
						</time>
					</a>
					{location && (
						<span class="page-location" title={location}>
							<Icon name="material-symbols:location-on-rounded" />
							<span>{location}</span>
						</span>
					)}
				</div>
			</div>
			<a
				class="page-permalink btn-plain"
				href={permalink}
				aria-label={i18n(I18nKey.dynamicPermalink)}
				title={i18n(I18nKey.dynamicPermalink)}
			>
				<Icon name="material-symbols:link-rounded" />
			</a>
		</header>

		<div id={`${anchorId}-content`} class="page-content custom-md">
			{Content ? <Content /> : <p>This update is available in Chinese only. <a href={"/dynamic/?lang=zh#" + anchorId}>Read the Chinese original</a></p>}
		</div>
		<DynamicGallery sourceId={`${anchorId}-content`} />
		{showInlineComments && commentPath && (
			<DynamicInlineComments
				src={url(`/dynamic/comments/?path=${encodeURIComponent(commentPath)}`)}
			/>
		)}
	</article>
</dynamic-entry>
