---
import { getLocaleFromPath, localizeConfigText } from "@/utils/locale";
const pageLocale = getLocaleFromPath(Astro.url.pathname);
const i18n = createTranslator(pageLocale);
import { Icon } from "astro-icon/components";
import "@/styles/markdown.css";
import "@/styles/markdown-extend.styl";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import DynamicGallery from "@/components/pages/dynamic/DynamicGallery.astro";
import DynamicInlineComments from "@/components/pages/dynamic/DynamicInlineComments.astro";
import { dynamicConfig, profileConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { createTranslator } from "@/i18n/translation";
import { url as baseUrl } from "@/utils/url-utils";

const profileLabel = i18n(I18nKey.dynamicProfile).replace(
	"{name}",
	localizeConfigText(profileConfig.name, pageLocale),
);
const profileUrl = url(dynamicConfig.profileUrl || "/about/");

function url(path: string): string { return baseUrl(path, pageLocale); }
---

<template data-dynamic-item-template>
	<dynamic-entry class="page-entry card-base" data-dynamic-entry>
		<article>
			<header class="page-entry-header">
				<a href={profileUrl} class="page-avatar" aria-label={profileLabel}>
					<ImageWrapper
						src={profileConfig.avatar || ""}
						alt={localizeConfigText(profileConfig.name, pageLocale)}
						widths={[96]}
						sizes="48px"
						loading="lazy"
						fadeIn={false}
					/>
				</a>
				<div class="page-identity">
					<a href={profileUrl} class="page-author" aria-label={profileLabel}>
						<strong data-dynamic-author>{localizeConfigText(profileConfig.name, pageLocale)}</strong>
					</a>
					<div class="page-meta">
						<a class="page-time" data-dynamic-permalink>
							<time data-dynamic-time></time>
						</a>
						<span class="page-location" data-dynamic-location hidden>
							<Icon name="material-symbols:location-on-rounded" />
							<span data-dynamic-location-text></span>
						</span>
					</div>
				</div>
				<span class="page-pinned-badge" data-dynamic-pinned hidden>
	<Icon name="material-symbols:push-pin" class="size-3" />
	{i18n(I18nKey.pinned)}
</span>
				<span class="page-entry-decoration" aria-hidden="true">
					<Icon name="material-symbols:format-quote-rounded" />
				</span>
			</header>

			<div class="page-content custom-md" data-dynamic-content></div>
			<DynamicGallery sourceId="dynamic-template-content" />
			<DynamicInlineComments src="" />
		</article>
	</dynamic-entry>
</template>
