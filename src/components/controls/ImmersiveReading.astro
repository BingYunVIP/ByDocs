---
import { getLocaleFromPath } from "@/utils/locale";
const pageLocale = getLocaleFromPath(Astro.url.pathname);
const i18n = createTranslator(pageLocale);
import FloatingButton from "@/components/common/FloatingButton.astro";
import I18nKey from "@/i18n/i18nKey";
import { createTranslator } from "@/i18n/translation";
---

<FloatingButton
  id="immersive-reading-btn"
  icon="material-symbols:auto-stories"
  toggleIcon="material-symbols:logout"
  ariaLabel={i18n(I18nKey.enterImmersiveReading)}
  onclick="window.toggleImmersiveReading()"
  class="hide"
/>

<script>
  import { initImmersiveReading } from "@/utils/immersive-reading-utils";

  initImmersiveReading();
</script>
