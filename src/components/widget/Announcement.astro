---
import { getLocaleFromPath, localizeConfigText, toLocalePath } from "@/utils/locale";
const pageLocale = getLocaleFromPath(Astro.url.pathname);
const i18n = createTranslator(pageLocale);
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { createTranslator } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
<WidgetLayout
  name={localizeConfigText(config.title || "", pageLocale) || i18n(I18nKey.announcement)}
  showTitle={showTitle}
  id="announcement"
  class={className}
  style={style}
>
  <div>
    <!-- 公告栏内容 -->
    <div class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3">
      {pageLocale === "en" && config.content === "欢迎来到我的博客！这是一则示例公告。" ? "Welcome to my blog! This is a sample announcement." : localizeConfigText(config.content, pageLocale)}
    </div>

    <!-- 可选链接和关闭按钮 -->
    <div class="flex items-center justify-between gap-3">
      <div>
        {
          config.link && config.link.enable !== false && (
            <a
              href={config.link.external ? config.link.url : toLocalePath(config.link.url, pageLocale)}
              target={config.link.external ? "_blank" : "_self"}
              rel={config.link.external ? "noopener noreferrer" : undefined}
              class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
            >
              {pageLocale === "en" && config.link.text === "了解更多" ? "Learn more" : localizeConfigText(config.link.text, pageLocale)}
            </a>
          )
        }
      </div>

      {
        config.closable && (
          <button
            class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
            onclick="this.closest('widget-layout').style.display='none'"
            aria-label={i18n(I18nKey.announcementClose)}
          >
            <Icon name="fa7-solid:xmark" class="text-sm" />
          </button>
        )
      }
    </div>
  </div>
</WidgetLayout>
