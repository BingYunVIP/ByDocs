---
import { getLocaleFromPath } from "@/utils/locale";

import ArchivePanel from "@components/controls/ArchivePanel.astro";
import I18nKey from "@i18n/i18nKey";
import { createTranslator } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const pageLocale = getLocaleFromPath(Astro.url.pathname);
const i18n = createTranslator(pageLocale);
---

<MainGridLayout title={i18n(I18nKey.archive)}>
  <ArchivePanel />
</MainGridLayout>
