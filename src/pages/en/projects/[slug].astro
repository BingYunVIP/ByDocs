---
import Page from "@/pages/projects/[slug].astro";
import { getSortedProjects } from "@/utils/content-utils";
import { removeFileExtension } from "@/utils/url-utils";
export async function getStaticPaths() { return (await getSortedProjects("en")).map(entry => ({params:{slug: removeFileExtension(entry.id)},props:{entry}})); }
---
<Page {...Astro.props} />
